{
  "name": "Frise chronologique",
  "version": "1.4",
  "language": "fr",
  "description": "Editeur visuel de frises chronologiques pilotable par donnees structurees.",
  "entrypoint": "index.html",
  "browserApi": "window.timelineAgent",
  "recommendedFlow": [
    "Appeler window.timelineAgent.describe() pour lire le contrat et le schema.",
    "Construire un objet JSON contenant title, start, end, events et periods. Utiliser date, startDate et endDate au format ISO pour les dates calendaires exactes.",
    "Appeler window.timelineAgent.importState(payload).",
    "Verifier le resultat avec window.timelineAgent.getState(); l'import adapte automatiquement la largeur des cartes au contenu et repartit les evenements pour eviter les collisions."
  ],
  "methods": {
    "describe": {
      "arguments": [],
      "returns": "Descriptor"
    },
    "getState": {
      "arguments": [],
      "returns": "TimelineState"
    },
    "importState": {
      "arguments": [
        "TimelinePayload|string"
      ],
      "returns": "TimelineState"
    },
    "addEvent": {
      "arguments": [
        "EventInput"
      ],
      "returns": "Event"
    },
    "addPeriod": {
      "arguments": [
        "PeriodInput"
      ],
      "returns": "Period"
    },
    "clear": {
      "arguments": [],
      "returns": "TimelineState"
    },
    "undo": {
      "arguments": [],
      "returns": "TimelineState"
    },
    "redo": {
      "arguments": [],
      "returns": "TimelineState"
    },
    "setZoom": {
      "arguments": ["number:0.5..2"],
      "returns": "number"
    },
    "setDateFormat": {
      "arguments": ["numeric|long"],
      "returns": "numeric|long"
    },
    "setPanels": {
      "arguments": ["{editor?:boolean,elements?:boolean}"],
      "returns": "{editor:boolean,elements:boolean}"
    },
    "getPrompt": {
      "arguments": [
        "topic:string",
        "options?:{eventCount,periodCount,imageMode,mode}"
      ],
      "returns": "string"
    }
  },
  "aiGenerationOptions": {
    "eventCount": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
    "periodCount": { "type": "integer", "minimum": 0, "maximum": 10, "default": 3 },
    "imageMode": {
      "type": "string",
      "enum": ["none", "highlights", "all"],
      "default": "highlights"
    },
    "mode": {
      "type": "string",
      "enum": ["chatbot", "agent"],
      "default": "chatbot"
    }
  },
  "domActions": {
    "openAiAssistant": "[data-agent-action='open-ai-assistant']",
    "copyPrompt": "[data-agent-action='copy-prompt']",
    "importAiJson": "[data-agent-action='import-ai-json']",
    "addEvent": "[data-agent-action='add-event']",
    "addPeriod": "[data-agent-action='add-period']",
    "downloadJson": "[data-agent-action='download-json']",
    "exportPng": "[data-agent-action='export-png']",
    "exportPdf": "[data-agent-action='export-pdf']",
    "exportHtml": "[data-agent-action='export-html']",
    "undo": "#undo-action",
    "redo": "#redo-action",
    "zoomOut": "#zoom-out",
    "zoomReset": "#zoom-reset",
    "zoomIn": "#zoom-in",
    "toggleEditorPanel": "#toggle-editor-panel",
    "toggleElementsPanel": "#toggle-elements-panel"
  },
  "domInputs": {
    "aiTopic": "#ai-topic",
    "aiEventCount": "#ai-event-count",
    "aiPeriodCount": "#ai-period-count",
    "aiImageMode": "#ai-image-mode",
    "dateFormat": "[data-setting='dateFormat']",
    "baselineThickness": "[data-setting='baselineThickness']",
    "chatbotPromptMode": "[data-ai-prompt-mode='chatbot']",
    "agentPromptMode": "[data-ai-prompt-mode='agent']",
    "aiJson": "#ai-json-input"
  },
  "renderVerification": {
    "timeline": "#timeline-space",
    "eventCountAttribute": "data-event-count",
    "periodCountAttribute": "data-period-count",
    "eventCards": ".event",
    "eventDates": ".event .date"
  },
  "dateSupport": {
    "eventExactDate": "date:YYYY-MM-DD",
    "periodExactDates": "startDate/endDate:YYYY-MM-DD",
    "yearOnly": "value or start/end as integers",
    "display": ["DD.MM.YYYY", "D mois YYYY"],
    "stateProperty": "dateFormat:numeric|long"
  },
  "eventResize": {
    "interaction": "drag any event-card corner",
    "visualHandle": false,
    "stateProperties": ["width", "height"],
    "cursor": ["nwse-resize", "nesw-resize"]
  },
  "workspaceLayout": {
    "panels": ["editor", "elements"],
    "browserApiMethod": "setPanels",
    "gridBackground": false,
    "baselineThickness": "baselineThickness:1..12"
  },
  "stateChangeEvent": "timeline:statechange",
  "schemaSelector": "#timeline-agent-schema"
}
